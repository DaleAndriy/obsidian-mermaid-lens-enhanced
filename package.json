{
  "name": "obsidian-mermaid-lens-enhanced",
  "version": "0.2.3",
  "description": "Enhance Mermaid diagrams with clear flowchart routing, a shared theme, a pan-and-zoom viewer, and image copying.",
  "main": "dist/main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "typecheck:test": "tsc --noEmit -p tsconfig.tests.json",
    "build": "tsc --noEmit && npm run typecheck:test && node esbuild.config.mjs production",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "release": "node scripts/prepare-release.mjs"
  },
  "keywords": [
    "obsidian",
    "mermaid"
  ],
  "author": "DaleAndriy",
  "repository": "github:DaleAndriy/obsidian-mermaid-lens-enhanced",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "happy-dom": "^20.11.0",
    "obsidian": "latest",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "beautiful-mermaid": "1.1.3"
  },
  "contributors": [
    "aitsuki"
  ]
}
